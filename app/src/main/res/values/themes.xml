<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window/launch theme only. Actual UI colors are driven by the Compose PhotonTheme, which also
      handles light/dark; the window shows the brand plate of the phone's mode until it draws.
    -->
