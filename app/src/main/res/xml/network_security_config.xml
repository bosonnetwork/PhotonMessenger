<?xml version="1.0" encoding="utf-8"?>
<!--
  Production/default policy: HTTPS-only, no cleartext traffic anywhere (X-S4). The debug build
  overrides this file (app/src/debug/res/xml/network_security_config.xml) to permit cleartext to the
  local dev super node only. Any non-debug build (release, benchmark, etc.) inherits this strict
  config, so a dev host can never accidentally ship in a release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
